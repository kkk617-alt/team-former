# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채웁니다.
#   - 파일 이름은 정확히 `.env` 여야 합니다. 편집기가 `.env.txt` 로 저장하면
#     .gitignore 가 걸러 내지 못해 키가 깃허브에 올라갑니다 (공고 4.1절).
#   - `.env` 는 두 번 눌러 열지 않습니다.
#   - 배포할 때는 같은 이름들을 Streamlit Secrets 에 넣습니다 (공고 4.4절).

# 오픈라우터 API 키 — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-여기에-자기-키"

# Supabase DB 주소
#   Streamlit Community Cloud 는 IPv4 로만 접속하는데 Supabase 무료 프로젝트의
#   직결 주소(db.xxx.supabase.co:5432)는 IPv6 전용입니다. 반드시 풀러(Supavisor)
#   주소를 쓰세요. Supabase 대시보드 > Connect > "Session pooler" 의 주소입니다.
#   형태: postgresql://postgres.<프로젝트참조>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.xxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# 관리자(교수) 비밀번호 — e-class 제출 칸에만 적습니다
ADMIN_PASSWORD="정한-관리자-비밀번호"

# (선택) 오픈라우터 모델 3개. 비워 두면 app/config.py 의 기본값을 씁니다.
# AI_MODEL_1="..."
# AI_MODEL_2="..."
# AI_MODEL_3="..."
